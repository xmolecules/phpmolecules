{
  "name": "xmolecules/phpmolecules",
  "type": "library",
  "description": "Libraries to help developers express architectural abstractions in PHP code",
  "homepage": "https://xmolecules.org/",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Henning Schwentner",
      "email": "hs@wps.de",
      "homepage": "http://hschwentner.io"
    }
  ],
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.7",
    "rector/rector": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "PHPMolecules\\DDD\\": "src/DDD"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PHPMolecules\\DDD\\": "tests/DDD"
    }
  },
  "scripts": {
    "unit": "phpunit --colors=always",
    "stan": "phpstan analyse",
    "cs-check": "phpcs --version && phpcs -p --cache",
    "cs-fix": "phpcbf",
    "composer-audit": "composer audit",
    "rector": "vendor/bin/rector process --dry-run",
    "rector-fix": "vendor/bin/rector process",
    "fix": [
      "@cs-fix",
      "@rector-fix"
    ],
    "test": [
      "@unit",
      "@cs-check",
      "@stan",
      "@rector",
      "@composer-audit"
    ]
  }
}
